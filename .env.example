# Copy to .env.local and fill in real values. Never commit .env/.env.local.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional demo mode: if BOTH are set, the app auto signs in as this one
# account on load instead of showing the login form. For showing the app
# off only — leave both unset for real multi-user staff use, since a demo
# account gives every visitor the same identity/data.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
